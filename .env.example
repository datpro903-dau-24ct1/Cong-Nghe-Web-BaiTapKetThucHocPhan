# Sao chép thành .env rồi điền giá trị thật: cp .env.example .env
# Sinh khóa: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=doi-thanh-khoa-bi-mat-cua-ban
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Cơ sở dữ liệu: mysql (MariaDB/MySQL, ví dụ XAMPP) hoặc sqlite (mặc định)
# Với mysql: tạo trước DB bằng
#   CREATE DATABASE shopmohinh CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=shopmohinh
DJANGO_DB_USER=root
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306
